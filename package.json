{
  "name": "patas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "precompute": "node --experimental-strip-types scripts/precompute.ts",
    "smoke": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/smoke.ts",
    "fetch:venues": "node --experimental-strip-types scripts/fetch-venues.ts",
    "fetch:landmarks": "node --experimental-strip-types scripts/fetch-landmarks.ts",
    "fetch:boundary": "node --experimental-strip-types scripts/fetch-boundary.ts",
    "fetch:tiles": "node --experimental-strip-types scripts/fetch-tiles.ts",
    "screenshots": "node --experimental-strip-types scripts/screenshots.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/db.ts migrate",
    "db:purge": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/db.ts purge"
  },
  "dependencies": {
    "h3-js": "^4.5.0",
    "leaflet": "^1.9.4",
    "next": "^15",
    "pg": "^8.23.1",
    "protomaps-leaflet": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright-core": "^1.63.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.6"
  }
