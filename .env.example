# Provider selection (defaults: ors + snapshot — free, OSM-based)
ROUTING_PROVIDER=ors          # ors | google | estimate (no-key dev mode, fake times)
CANDIDATE_SOURCE=snapshot     # snapshot (data/qc-venues.json) | overpass | google

# OpenRouteService — free key at account.heigit.org. Server-side only.
ORS_API_KEY=
# Optional; default https://api.heigit.org/openrouteservice
ORS_BASE_URL=

# Overpass — optional self-hosted/paid instance; contact for User-Agent etiquette
OVERPASS_URL=
OVERPASS_CONTACT=

# Google (fallback). Restrict key to Routes API + Places API (New).
GOOGLE_MAPS_API_KEY=

# Postgres for group links: Neon's pooled connection string (host contains -pooler).
# Unset in dev = a local PGlite database in .data/pglite. Run npm run db:migrate after setting it.
DATABASE_URL=

# Optional: Discord channel webhook; each feedback submission pings it (user text can't @mention).
FEEDBACK_WEBHOOK_URL=

# Shown on /privacy as the contact for questions and deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: serve the map file from object storage instead of /tiles/.
NEXT_PUBLIC_TILES_URL=

# Precomputed cell→venue tables (scripts/precompute.ts output). Unset = live routing.
PRECOMPUTED_DIR=data/tables
# Precompute throttling
CHUNK_ORIGINS=25
CHUNK_DEST=25
SLEEP_MS=1500
