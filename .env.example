# Provider selection (defaults: ors + overpass — free, OSM-based)
ROUTING_PROVIDER=ors          # ors | google
CANDIDATE_SOURCE=overpass     # overpass | google

# OpenRouteService — free key at openrouteservice.org. Server-side only.
ORS_API_KEY=

# Overpass — optional self-hosted/paid instance; contact for User-Agent etiquette
OVERPASS_URL=
OVERPASS_CONTACT=

# Google (fallback). Restrict key to Routes API + Places API (New).
GOOGLE_MAPS_API_KEY=

# Supabase (only needed once rotation/groups are wired)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Precomputed cell→venue tables (scripts/precompute.ts output). Unset = live routing.
PRECOMPUTED_DIR=data/tables
# Precompute throttling
CHUNK_ORIGINS=25
CHUNK_DEST=25
SLEEP_MS=1500
