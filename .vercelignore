# `vercel deploy` uploads this folder from disk. Unlike git, it must include
# public/tiles/ (the gitignored map file), and must never include secrets
# or local state.
.env
.env.*
!.env.example
.data/
.next/
node_modules/
.claude/
.git/
*.tsbuildinfo
# The map file is fetched during the Vercel build (vercel-build script), not uploaded.
public/tiles/
